# ============================================================
# Aurelia Data Platform - Environment variables (example)
# Copy this file to .env and adjust values. Never commit .env.
# ============================================================

# --- Postgres DWH (gold layer) ---
POSTGRES_DWH_HOST=postgres-dwh
POSTGRES_DWH_PORT=5432
POSTGRES_DWH_USER=aurelia
POSTGRES_DWH_PASSWORD=aurelia
POSTGRES_DWH_DB=aurelia_dwh

# --- Postgres for Airflow metadata ---
POSTGRES_AIRFLOW_HOST=postgres-airflow
POSTGRES_AIRFLOW_PORT=5432
POSTGRES_AIRFLOW_USER=airflow
POSTGRES_AIRFLOW_PASSWORD=airflow
POSTGRES_AIRFLOW_DB=airflow

# --- MinIO (S3-compatible object storage) ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=True
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# --- Blacklist mock API ---
BLACKLIST_API_URL=http://blacklist-api:8000/v1/blacklist
# Where the FastAPI mock reads the blacklist from inside its container.
# scripts/generate_data.py writes to data/raw/blacklist.json, which is
# bind-mounted into the container at /data/raw.
BLACKLIST_JSON_PATH=/data/raw/blacklist.json

# --- Spark ---
SPARK_MASTER=local[*]

# --- Kafka (streaming track) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_EVENTS=aurelia.events
# Checkpoint dir persists on a docker volume, not on S3/MinIO (avoids
# S3A + rename atomicity issues with Structured Streaming).
KAFKA_CHECKPOINT_DIR=/opt/airflow/checkpoints/events_stream
